
#include <winres.h>
#include "resource.h"

// ============================================================
// OBS Orientation Switcher
// Embedded Developer Avatar
// ============================================================

IDR_DEVELOPER_AVATAR RCDATA "../assets/lordvadercw.png"

// ============================================================
// Windows File Version Information
// ============================================================

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PLUGIN_VERSION_NUMERIC
 PRODUCTVERSION PLUGIN_VERSION_NUMERIC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", PLUGIN_COMPANY_NAME "\0"
            VALUE "FileDescription", PLUGIN_FILE_DESCRIPTION "\0"
            VALUE "FileVersion", PLUGIN_VERSION_STRING "\0"
            VALUE "InternalName", PLUGIN_INTERNAL_NAME "\0"
            VALUE "LegalCopyright", PLUGIN_COPYRIGHT "\0"
            VALUE "OriginalFilename", PLUGIN_ORIGINAL_FILENAME "\0"
            VALUE "ProductName", PLUGIN_PRODUCT_NAME "\0"
            VALUE "ProductVersion", PLUGIN_VERSION_STRING "\0"
            VALUE "Comments", PLUGIN_COMMENTS "\0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
